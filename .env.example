# BookOrbit server (your self-hosted instance)
BOOKORBIT_URL=http://192.168.1.10:3000
BOOKORBIT_USERNAME=your-username
BOOKORBIT_PASSWORD=your-password

# Obsidian vault destination
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian/vault
# Subfolder inside the vault that receives the notes (created if missing)
OBSIDIAN_OUTPUT_DIR=BookOrbit

# Optional tuning
# Number of trailing days for the reading heatmap (max 3650)
HEATMAP_DAYS=365
# Set to false to skip the "Want to read" shelf
SHOW_WANT_TO_READ=true

# Persisted login session (refresh-token reuse).
# The script logs in once and reuses the session afterwards, so your BookOrbit
# Sessions list stays at one entry instead of growing hourly. The file contains
# tokens as sensitive as a password — keep it out of git and set mode 0600.
BOOKORBIT_SESSION_FILE=.bookorbit-session.json
# Label shown in BookOrbit > Settings > Sessions for this device
BOOKORBIT_DEVICE_LABEL=bookorbit-to-obsidian sync